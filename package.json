{
  "name": "taxo-store-shell",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:libs": "ng build @myrmidon/taxo-store-api && ng build @myrmidon/taxo-store-editor && ng build @myrmidon/taxo-store-picker"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@angular/cdk": "~22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/material": "~22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@myrmidon/auth-jwt-admin": "^10.0.0",
    "@myrmidon/auth-jwt-login": "^10.0.0",
    "@myrmidon/cadmus-refs-lookup": "^11.0.8",
    "@myrmidon/cadmus-refs-viaf-lookup": "^11.0.3",
    "@myrmidon/ngx-mat-tools": "^3.0.1",
    "@myrmidon/ngx-tools": "^3.0.2",
    "@myrmidon/paged-data-browsers": "^6.0.1",
    "rxjs": "~7.8.0",
    "ts-md5": "^2.0.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/localize": "^22.2.2",
    "@vitest/coverage-v8": "^5.0.4",
    "jsdom": "^30.1.2",
    "ng-packagr": "^22.2.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
